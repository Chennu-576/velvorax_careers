PROJECT_NAME=VELVORAX Careers API
VERSION=1.0.0
API_V1_STR=/api/v1
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:replace-me@localhost:5432/velvorax_careers
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTO_VERIFY_NEW_USERS=false
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://velvorax-careers.vercel.app"]
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=""
BLOB_READ_WRITE_TOKEN=
MAX_RESUME_SIZE_BYTES=2097152
MAX_TOTAL_STORAGE_BYTES=996147200
